# ============================================================================
# 7didan knowledge base — Docker environment template
# ----------------------------------------------------------------------------
# This file is the DOCUMENTED template for `docker compose up` (compose reads
# it via `env_file: .env.docker`). It is committed on purpose (!.env.docker in
# .gitignore) so collaborators know every variable the project needs.
#
# NEVER put real secrets here: LLM_API_KEY, POSTGRES_PASSWORD and WEBHOOK_TOKEN
# are placeholders. Copy your real values from your local `.env` (gitignored)
# when running locally.
# ============================================================================

# ------------------------- Ingestion pipeline ------------------------------
# knowledge_base/main.py --crawl / --parse
CRAWLER_URLS=knowledge_base/src/config/crawler.json   # JSON list of URLs to crawl
PARSER_CONFIG=knowledge_base/src/config/parser.json   # PDF parser (docling) config
RAW_DATA_PATH=knowledge_base/data/raw/markdown         # output dir for cleaned .md (+ sidecar .json with source_url)
PDF_DATA_PATH=knowledge_base/data/raw/pdf              # input dir for PDFs
NUM_WORKER=4                                           # cleaner worker pool size
CHUNK_SIZE=1500                                        # markdown chunk size (chars)
CHUNK_OVERLAP=75                                       # overlap between chunks (chars)

# ------------------------- Embedding model ---------------------------------
MODEL_NAME=Qwen/Qwen3-Embedding-0.6B                   # HF model for chunk/query embeddings
MODEL_CONFIG=knowledge_base/src/config/model.json      # encode kwargs for the embedder
VECTOR_SIZE=1024                                       # embedding dimension (must match model)

# ------------------------- PostgreSQL (pgvector) ---------------------------
# Inside docker-compose the db service is reachable as host `db`
# (compose sets POSTGRES_HOST=db for the api container automatically).
POSTGRES_USER=7didan
POSTGRES_PASSWORD=change-me                            # TODO: real password from your local .env
POSTGRES_HOST=db                                       # use `localhost` when running outside Docker
POSTGRES_PORT=5432
POSTGRES_DB=7didan_db
POSTGRES_TABLE=7didan_store                            # pgvector table; reporting schema = reporting.conversation_events

# ------------------------- Retrieval / reranking ---------------------------
RETRIEVAL_SEARCH_CRITERION=similarity
RETRIEVAL_TOP_K=20                                     # candidates from vector search
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_TOP_K=10                                      # docs sent to the LLM after reranking
RERANKER_DEVICE=cpu                                    # use `cuda` if the container has a GPU
RERANKER_BATCH_SIZE=2

# ------------------------- LLM (NVIDIA build API) --------------------------
LLM_MODEL_NAME=mistralai/mistral-large-4-1t-a52b
LLM_MODEL_PROVIDER=openai                              # NVIDIA exposes an OpenAI-compatible API
LLM_TEMPERATURE=0.5
LLM_API_KEY=nvapi-change-me                            # TODO: your NVIDIA API key (integrate.api.nvidia.com)
BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------- Prompts -----------------------------------------
PROMPT_DIR=retrieval_service/src/prompts               # RAG prompt templates

# ========================= CRM integration ==================================
# Flow: FastAPI -> n8n webhook -> Odoo CRM (crm.lead)
# n8n runs on the HOST (the 7didan-marketing project); from inside the api
# container it is reachable as host.docker.internal (see extra_hosts in
# docker-compose.yml).
# ----------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/7didan/lead   # use http://localhost:5678/... outside Docker
WEBHOOK_TOKEN=change-me                                # TODO: shared secret; must equal WEBHOOK_TOKEN in the n8n project's .env. Sent as header X-7didan-Token.
CRM_MAX_RETRIES=3                                      # retries on retryable failures only, same submission_id (idempotent)
CRM_BASE_TIMEOUT=30.0
CRM_BACKOFF_FACTOR=2.0
