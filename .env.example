# ============================================================================
# 7didan knowledge base — LOCAL environment template (.env, gitignored)
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env        (Linux/macOS)   |   Copy-Item .env.example .env
# The committed `.env.docker` is the documented template for `docker compose`.
# ============================================================================

# ------------------------- Ingestion pipeline ------------------------------
CRAWLER_URLS=knowledge_base/src/config/crawler.json   # JSON list of URLs to crawl
PARSER_CONFIG=knowledge_base/src/config/parser.json   # PDF parser (docling) config
RAW_DATA_PATH=knowledge_base/data/raw/markdown
PDF_DATA_PATH=knowledge_base/data/raw/pdf
NUM_WORKER=4
CHUNK_SIZE=1500
CHUNK_OVERLAP=75

# ------------------------- Embedding model ---------------------------------
MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
MODEL_CONFIG=knowledge_base/src/config/model.json
VECTOR_SIZE=1024

# ------------------------- PostgreSQL (pgvector) ---------------------------
POSTGRES_USER=7didan
POSTGRES_PASSWORD=change-me            # TODO: real DB password
POSTGRES_HOST=localhost                # `db` when running inside docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=7didan_db
POSTGRES_TABLE=7didan_store

# ------------------------- Retrieval / reranking ---------------------------
RETRIEVAL_SEARCH_CRITERION=similarity
RETRIEVAL_TOP_K=20
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_TOP_K=10
RERANKER_DEVICE=cuda                   # `cpu` if no GPU
RERANKER_BATCH_SIZE=2

# ------------------------- LLM (NVIDIA build API, OpenAI-compatible) -------
LLM_MODEL_NAME=mistralai/mistral-large-4-1t-a52b
LLM_MODEL_PROVIDER=openai
LLM_TEMPERATURE=0.5
LLM_API_KEY=nvapi-change-me            # TODO: your NVIDIA API key
BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------- Prompts -----------------------------------------
PROMPT_DIR=retrieval_service/src/prompts

# ------------------------- CRM integration (FastAPI -> n8n -> Odoo) --------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/7didan/lead   # host.docker.internal:5678 inside Docker
WEBHOOK_TOKEN=change-me                # TODO: shared secret; must match WEBHOOK_TOKEN in the n8n project (.env of 7didan-marketing). Sent as X-7didan-Token.
CRM_MAX_RETRIES=3
CRM_BASE_TIMEOUT=30.0
CRM_BACKOFF_FACTOR=2.0
